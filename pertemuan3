        const quizQuestions = [
            {
                q: "Seorang dosen membawa mahasiswa Teknologi Pendidikan ke area hutan mangrove untuk mengamati ekosistem secara langsung tanpa membawa alat elektronik. Menurut Punaji Setyosari & Sihkabuden, hutan mangrove tersebut masuk dalam kategori media...",
                options: [
                    "Media Dirancang (*Media by Design*)",
                    "Media Dimanfaatkan (*Media by Utilization*)",
                    "Big Media Kompleks",
                    "Media Terproyeksi Digital"
                ],
                correct: 1,
                exp: "Setyosari membedakan 'Media by Design' (dibuat khusus instruksional) dan 'Media by Utilization' (lingkungan sekitar yang dimanfaatkan untuk belajar meskipun tidak khusus dirancang untuk itu)."
            },
            {
                q: "Manakah perbedaan mendasar antara taksonomi Rudy Bretz dan taksonomi Wilbur Schramm?",
                options: [
                    "Bretz mendasarkan pada 3 unsur indera (Suara, Visual, Gerak), sedangkan Schramm mendasarkan pada kompleksitas/biaya dan daya liput jangkauan",
                    "Bretz membagi media menjadi 10 kelompok, sedangkan Schramm membagi media menjadi 2 kelompok saja",
                    "Schramm hanya meneliti media komputer, sedangkan Bretz fokus pada media cetak",
                    "Bretz dan Schramm menggunakan kriteria yang persis sama tanpa perbedaan"
                ],
                correct: 0,
                exp: "Rudy Bretz berfokus pada ciri fisik indera (suara, visual, gerak), sedangkan Wilbur Schramm menggunakan kriteria ekonomis/kerumitan (Big vs Little Media) serta daya liput sasaran."
            },
            {
                q: "Klasifikasi media yang secara eksplisit menempatkan 'Manusia' (seperti guru, narasumber, tutor) sebagai salah satu kelompok media mandiri dikemukakan oleh...",
                options: [
                    "Gerlach & Ely",
                    "Leshin, Pollock & Reigeluth",
                    "Seels & Glasgow",
                    "Rudy Bretz"
                ],
                correct: 1,
                exp: "Leshin, Pollock & Reigeluth mengklasifikasikan 5 media utama: Berbasis Manusia, Berbasis Cetak, Berbasis Visual, Berbasis Audio-Visual, dan Berbasis Komputer."
            },
            {
                q: "Teknologi seperti Virtual Reality (VR), Augmented Reality (AR), dan Hypermedia interaktif dalam taksonomi Seels & Glasgow dimasukkan ke dalam kelompok...",
                options: [
                    "Pilihan Media Tradisional",
                    "Pilihan Media Teknologi Mutakhir (Berbasis Mikroprosesor)",
                    "Media Pajang Pameran",
                    "Media Cetak Terprogram"
                ],
                correct: 1,
                exp: "Seels & Glasgow membagi media menjadi Era Tradisional dan Era Teknologi Mutakhir (yang mencakup mikroprosesor, telekomunikasi, VR, dan hypermedia)."
            },
            {
                q: "Model integrasi media ASSURE yang menjadi standar pengelompokan media AECT dikembangkan oleh...",
                options: [
                    "Heinich, Molenda, Russell & Smaldino",
                    "Rudy Bretz & Ronald Anderson",
                    "Gerlach & Ely",
                    "Wilbur Schramm"
                ],
                correct: 0,
                exp: "Model ASSURE dikembangkan oleh Heinich, Molenda, Russell, & Smaldino sebagai kerangka kerja integrasi media ke dalam perencanaan instruksional."
            }
