                            <tr class="hover:bg-slate-50"><td class="p-3 font-bold">2</td><td class="p-3 font-semibold text-slate-900">Audio-Visual Diam</td><td class="p-3">Suara + Visual Diam</td><td class="p-3">Slide bersuara (*Sound-Slide*), Filmstrip audio</td></tr>
                            <tr class="hover:bg-slate-50"><td class="p-3 font-bold">3</td><td class="p-3 font-semibold text-slate-900">Audio Semi-Gerak</td><td class="p-3">Suara + Tulisan/Garis Bergerak</td><td class="p-3">Telewriting, Papan Tulis Elektronik Real-time</td></tr>
                            <tr class="hover:bg-slate-50"><td class="p-3 font-bold">4</td><td class="p-3 font-semibold text-slate-900">Visual Gerak</td><td class="p-3">Visual + Gerak (Tanpa Suara)</td><td class="p-3">Film bisu, GIF animasi instruksional</td></tr>
                            <tr class="hover:bg-slate-50"><td class="p-3 font-bold">5</td><td class="p-3 font-semibold text-slate-900">Visual Diam</td><td class="p-3">Visual Diam (Tanpa Suara)</td><td class="p-3">Foto, Poster, Infografis, OHP, Slide Bisu</td></tr>
                            <tr class="hover:bg-slate-50"><td class="p-3 font-bold">6</td><td class="p-3 font-semibold text-slate-900">Visual Semi-Gerak</td><td class="p-3">Visual Bergerak Terbatas</td><td class="p-3">Teleautograph, Faksimili interaktif</td></tr>
                            <tr class="hover:bg-slate-50"><td class="p-3 font-bold">7</td><td class="p-3 font-semibold text-slate-900">Audio</td><td class="p-3">Hanya Suara</td><td class="p-3">Radio, Podcast, Rekaman MP3, Cassette</td></tr>
                            <tr class="hover:bg-slate-50"><td class="p-3 font-bold">8</td><td class="p-3 font-semibold text-slate-900">Cetak</td><td class="p-3">Simbol Visual Tertulis</td><td class="p-3">Buku teks, Modul cetak, Brosur, Handout</td></tr>
                        </tbody>
