            <!-- EXPERT 3: Kemp & Dayton -->
            <div id="expert-kempdayton" class="expert-content hidden bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-6">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-100 pb-4">
                    <div>
                        <span class="text-xs font-extrabold text-edu-600 tracking-wider uppercase">Taksonomi 03</span>
                        <h3 class="text-2xl font-bold text-slate-900">Kemp & Dayton (1985)</h3>
                        <p class="text-xs text-slate-500">Dasar Klasifikasi: Karakteristik Pembuatan & Format Penyampaian</p>
                    </div>
                    <span class="px-3 py-1 bg-emerald-100 text-emerald-800 font-bold text-xs rounded-full">8 Kelompok Praktis</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="p-4 border border-slate-200 rounded-xl hover:border-edu-300 transition">
                        <h4 class="font-bold text-slate-900 text-sm mb-1">1. Media Cetak (*Printed Media*)</h4>
                        <p class="text-xs text-slate-600">Modul, panduan belajar, buku acuan, teks terprogram.</p>
                    </div>
                    <div class="p-4 border border-slate-200 rounded-xl hover:border-edu-300 transition">
                        <h4 class="font-bold text-slate-900 text-sm mb-1">2. Media Pajang (*Display Media*)</h4>
                        <p class="text-xs text-slate-600">Papan tulis, papan flanel, papan buletin, poster pameran.</p>
                    </div>
                    <div class="p-4 border border-slate-200 rounded-xl hover:border-edu-300 transition">
                        <h4 class="font-bold text-slate-900 text-sm mb-1">3. Transparansi Overhead (OHP)</h4>
                        <p class="text-xs text-slate-600">Lembar transparansi plastik untuk presentasi tatap muka.</p>
