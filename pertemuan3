        let quizIndex = 0;
        let userScore = 0;

        function renderQuizQuestion() {
            const qObj = quizQuestions[quizIndex];
            document.getElementById('quiz-progress-text').innerText = `Soal ${quizIndex + 1} dari ${quizQuestions.length}`;
            document.getElementById('quiz-question-text').innerText = qObj.q;

            const optsDiv = document.getElementById('quiz-options-container');
            optsDiv.innerHTML = '';

            qObj.options.forEach((optText, i) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-4 rounded-xl border border-slate-200 hover:bg-edu-50 hover:border-edu-300 transition text-xs sm:text-sm font-semibold text-slate-800 flex items-center space-x-3";
                btn.innerHTML = `<span class="w-6 h-6 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center text-xs font-bold flex-shrink-0">${String.fromCharCode(65 + i)}</span><span>${optText}</span>`;
                btn.onclick = () => handleAnswerSelect(i);
                optsDiv.appendChild(btn);
            });

            document.getElementById('quiz-explanation').classList.add('hidden');
            document.getElementById('quiz-next-btn').classList.add('hidden');
        }

        function handleAnswerSelect(selectedIdx) {
            const qObj = quizQuestions[quizIndex];
            const expDiv = document.getElementById('quiz-explanation');
            const optsContainer = document.getElementById('quiz-options-container').children;

            // Disable buttons
            for (let b of optsContainer) {
                b.disabled = true;
                b.classList.add('opacity-70', 'cursor-not-allowed');
            }

            if (selectedIdx === qObj.correct) {
                userScore += 20;
                document.getElementById('quiz-score-num').innerText = `Skor: ${userScore}`;
                expDiv.className = "p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs sm:text-sm";
                expDiv.innerHTML = `<strong>Jawaban Tepat!</strong> ${qObj.exp}`;
            } else {
                expDiv.className = "p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs sm:text-sm";
                expDiv.innerHTML = `<strong>Jawaban Kurang Tepat.</strong> ${qObj.exp}`;
            }

            expDiv.classList.remove('hidden');

            const nextBtn = document.getElementById('quiz-next-btn');
            if (quizIndex < quizQuestions.length - 1) {
                nextBtn.innerText = "Soal Selanjutnya";
            } else {
                nextBtn.innerText = "Lihat Hasil Akhir";
            }
            nextBtn.classList.remove('hidden');
        }

        function nextQuizStep() {
            if (quizIndex < quizQuestions.length - 1) {
                quizIndex++;
                renderQuizQuestion();
            } else {
                // Show final score summary
                const quizBox = document.getElementById('quiz-box');
                quizBox.innerHTML = `
                    <div class="text-center py-8 space-y-4">
                        <div class="w-16 h-16 bg-edu-100 text-edu-700 rounded-full flex items-center justify-center mx-auto">
                            <i data-lucide="award" class="w-8 h-8"></i>
                        </div>
                        <h3 class="text-2xl font-bold text-slate-900">Evaluasi Selesai!</h3>
                        <p class="text-slate-600 text-sm">Skor Akhir Evaluasi Mahasiswa TP Anda:</p>
                        <div class="text-4xl font-black text-edu-600">${userScore} / 100</div>
                        <button onclick="location.reload()" class="px-6 py-3 bg-edu-600 text-white font-bold rounded-xl hover:bg-edu-700 transition text-sm">
                            Ulangi Latihan Evaluasi
                        </button>
                    </div>
                `;
                lucide.createIcons();
            }
        }

        window.onload = function() {
            runMediaSimulation();
            renderQuizQuestion();
        };
