            // Show target expert
            document.getElementById(`expert-${expertId}`).classList.remove('hidden');

            // Highlight target tab
            const activeBtn = document.getElementById(`btn-${expertId}`);
            activeBtn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
